# --- ACR runtime (all optional locally) ---
ACR_ENV=dev                      # dev | prod
ACR_BASE_URL=http://localhost:8080
ACR_SECRET_KEY=change-me
ACR_ADMIN_PASSWORD=admin
ACR_DATABASE_URL=sqlite:///./data/acr.sqlite3     # prod: postgresql+psycopg://user:pw@/acr?host=/cloudsql/PROJECT:REGION:INSTANCE
ACR_STORAGE_BACKEND=local        # local | gcs
ACR_GCS_BUCKET=
ACR_ANCHOR_BACKEND=opentimestamps  # opentimestamps | local
ACR_LLM_MODE=live                # live | mock
ACR_MISSING_KEY_POLICY=mock      # mock | fail   (prod: fail)
ACR_REGISTRATION_TOKEN=          # if set, registration requires it
ACR_RATE_LIMIT_ENABLED=true
ACR_RATE_LIMIT_SUBMISSIONS_PER_DAY=20
ACR_EMBEDDED_WORKER=1            # run the job worker inside the web process (dev); prod runs `acr worker` separately

# --- model providers (committee) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=                # seed agents (open-weight models)
OPENROUTER_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
